<?xml version="1.0" encoding="utf-8"?>

<!-- Forma desenhável (shape) utilizada como fundo de componentes -->
<!-- Permite definir cor, borda e arredondamento -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cor de fundo do componente -->
    <!-- Define a aparência base do elemento -->
    <solid android:color="#F0F0F0"/>

    <!-- Configuração dos cantos arredondados -->
    <!-- O valor define o nível de curvatura das bordas -->
    <corners android:radius="20dp"/>

    <!-- Configuração da borda do componente -->
    <!-- Define a espessura da linha -->
    <!-- Define a cor da borda -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD"/>

</shape>