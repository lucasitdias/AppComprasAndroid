<!-- Drawable do tipo inset (aplica espaçamento interno em um drawable) -->
<!-- Define o drawable com margens internas em todos os lados -->
<!-- Mantém o conteúdo afastado das bordas do container -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/icon_app"
    android:insetTop="30dp"
    android:insetBottom="30dp"
    android:insetLeft="30dp"
    android:insetRight="30dp" />