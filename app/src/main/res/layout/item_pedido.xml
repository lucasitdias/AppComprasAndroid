<?xml version="1.0" encoding="utf-8"?>

<!-- CardView (container com bordas arredondadas e elevação) -->
<!-- Utilizado para representar um pedido -->
<!-- Destaca visualmente cada item da lista -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <!-- Layout interno do card -->
    <!-- Organiza os elementos em coluna -->
    <!-- Aplica espaçamento interno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Linha superior do pedido -->
        <!-- Exibe ID e data -->
        <!-- Organizado horizontalmente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Identificador do pedido -->
            <!-- Exibe número do pedido -->
            <!-- Destacado com cor primária -->
            <TextView
                android:id="@+id/txtPedidoId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido #1"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <!-- Data do pedido -->
            <!-- Exibe quando foi realizado -->
            <!-- Texto auxiliar -->
            <TextView
                android:id="@+id/txtPedidoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/10/2023"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Lista resumida de itens -->
        <!-- Exibe descrição dos produtos -->
        <!-- Complementa informações do pedido -->
        <TextView
            android:id="@+id/txtPedidoItens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Itens: ..."
            android:textSize="14sp"/>

        <!-- Linha inferior do pedido -->
        <!-- Exibe total e status -->
        <!-- Organizado horizontalmente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <!-- Valor total do pedido -->
            <!-- Exibe preço final -->
            <!-- Destacado em negrito -->
            <TextView
                android:id="@+id/txtPedidoTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: R$ 0,00"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <!-- Status do pedido -->
            <!-- Exibe situação atual -->
            <!-- Aplica fundo personalizado -->
            <TextView
                android:id="@+id/txtPedidoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Status"
                android:background="@drawable/bg_status_default"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>


        <!-- Botão de cancelar pedido -->
        <!-- Permite cancelar o pedido -->
        <!-- Inicialmente oculto -->
        <Button
            android:id="@+id/btnCancelarPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancelar Pedido"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/error"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>