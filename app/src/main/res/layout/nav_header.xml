<?xml version="1.0" encoding="utf-8"?>

<!-- Layout do cabeçalho do menu lateral (Navigation Drawer) -->
<!-- Organiza os elementos em coluna e posiciona conteúdo na parte inferior -->
<!-- Exibe informações básicas do usuário com destaque visual -->
<!-- Define cor de fundo e tema escuro para melhor contraste -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@color/primary"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <!-- Imagem de perfil do usuário -->
    <!-- Exibe avatar em formato circular -->
    <!-- Aplica borda branca para destaque visual -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfile"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/perfil"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp" />

    <!-- Texto responsável por exibir o nome do usuário ou aplicação -->
    <!-- Destaca a informação principal do cabeçalho -->
    <!-- Aplica estilo com negrito e espaçamento superior -->
    <TextView
        android:id="@+id/txtHeaderNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="TechStore"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textStyle="bold" />

    <!-- Texto responsável por exibir o email do usuário -->
    <!-- Complementa as informações do perfil no menu -->
    <!-- Mantém hierarquia visual com estilo mais discreto -->
    <TextView
        android:id="@+id/txtHeaderEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="contato@techstore.com" />

</LinearLayout>