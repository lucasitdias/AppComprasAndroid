<?xml version="1.0" encoding="utf-8"?>

<!-- Layout principal da tela de perfil -->
<!-- Organiza os elementos em coluna vertical -->
<!-- Centraliza o conteúdo na tela e aplica espaçamento interno -->
<!-- Define background e evita sobreposição de cliques -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Imagem de perfil do usuário -->
    <!-- Exibe a foto em formato circular -->
    <!-- Utiliza estilo customizado para recorte e aparência -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPerfil"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/perfil"
        app:shapeAppearanceOverlay="@style/CircleImage"
        android:elevation="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Texto responsável por exibir o nome do usuário -->
    <!-- Destaca a informação principal do perfil -->
    <!-- Aplica estilo com tamanho maior e negrito -->
    <TextView
        android:id="@+id/txtPerfilNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Usuário"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <!-- Texto responsável por exibir o e-mail do usuário -->
    <!-- Complementa as informações do perfil -->
    <!-- Define espaçamento superior para separação visual -->
    <TextView
        android:id="@+id/txtPerfilEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="usuario@email.com"
        android:textSize="16sp"
        android:textColor="@color/black" />

    <!-- Texto responsável por exibir o telefone do usuário -->
    <!-- Exibe informação adicional de contato -->
    <!-- Mantém hierarquia visual com tamanho menor -->
    <TextView
        android:id="@+id/txtPerfilTelefone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="(00) 00000-0000"
        android:textSize="14sp"
        android:textColor="@color/black" />

</LinearLayout>