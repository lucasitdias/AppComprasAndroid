<?xml version="1.0" encoding="utf-8"?>

<!-- Layout principal da tela -->
<!-- Organiza os elementos em coluna vertical -->
<!-- Centraliza e aplica espaçamento ao conteúdo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/background">

    <!-- Imagem do logo do aplicativo -->
    <!-- Define tamanho fixo para exibição -->
    <!-- Utilizada como identidade visual -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_techstore" />

    <!-- Texto de título da tela -->
    <!-- Indica a funcionalidade de recuperação de senha -->
    <!-- Destaca visualmente a ação principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar Senha"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="12dp"/>

    <!-- Texto de instrução ao usuário -->
    <!-- Explica o processo de recuperação -->
    <!-- Orienta a ação a ser realizada -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite seu e-mail para receber um link de redefinição"
        android:textSize="14sp"
        android:textColor="@color/textSecondary"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <!-- Campo de entrada para email -->
    <!-- Define container com estilo Material -->
    <!-- Exibe hint para orientação do usuário -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="E-mail"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="24dp">

        <!-- Campo de texto para digitação do email -->
        <!-- Define tipo de entrada como email -->
        <!-- Associado ao layout acima -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editResetEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botão para envio do link de recuperação -->
    <!-- Executa ação principal da tela -->
    <!-- Dispara envio de email de redefinição -->
    <Button
        android:id="@+id/btnEnviarReset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Enviar Link"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        android:textAllCaps="false"
        android:textSize="18sp"/>

    <!-- Texto para navegação de volta ao login -->
    <!-- Permite retornar à tela anterior -->
    <!-- Atua como ação alternativa -->
    <TextView
        android:id="@+id/txtVoltarLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar para o Login"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:padding="8dp"/>

</LinearLayout>