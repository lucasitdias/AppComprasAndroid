<?xml version="1.0" encoding="utf-8"?>

<!-- DrawerLayout (container principal com menu lateral) -->
<!-- Permite abrir e fechar um menu deslizante -->
<!-- Utilizado para navegação lateral no aplicativo -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Layout principal da tela -->
    <!-- Organiza os elementos da interface -->
    <!-- Contém toolbar, conteúdo e navegação inferior -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar do aplicativo -->
        <!-- Exibe ações e identidade visual -->
        <!-- Fica fixa no topo da tela -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:elevation="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetLeft="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetRight="0dp">

            <!-- Layout interno da toolbar -->
            <!-- Organiza os elementos com constraints -->
            <!-- Permite posicionamento flexível -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Botão de voltar -->
                <!-- Permite retornar à tela anterior -->
                <!-- Inicialmente oculto -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:visibility="gone"
                    app:tint="@color/primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Logo do aplicativo -->
                <!-- Centralizado na toolbar -->
                <!-- Representa a identidade visual -->
                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingVertical="4dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo_techstore"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Botão de menu -->
                <!-- Abre o menu lateral -->
                <!-- Posicionado à direita da toolbar -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Sombra abaixo da toolbar -->
        <!-- Cria separação visual -->
        <!-- Simula elevação da barra superior -->
        <View
            android:id="@+id/toolbar_shadow"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/toolbar"
            android:background="#DDDDDD" />

        <!-- Container principal de conteúdo -->
        <!-- Recebe fragments dinamicamente -->
        <!-- Área principal da aplicação -->
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_navigation"
            android:layout_below="@id/toolbar_shadow" />

        <!-- Navegação inferior -->
        <!-- Permite alternar entre telas principais -->
        <!-- Fixa na parte inferior da tela -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/surface"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/primary"
            app:itemTextColor="@color/primary"
            android:elevation="8dp"/>

    </RelativeLayout>

    <!-- Menu lateral (Navigation Drawer) -->
    <!-- Exibe opções de navegação adicionais -->
    <!-- Desliza pela lateral direita -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>