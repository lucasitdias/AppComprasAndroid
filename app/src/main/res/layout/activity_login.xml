<?xml version="1.0" encoding="utf-8"?>

<!-- Layout principal da tela -->
<!-- Organiza os elementos em coluna vertical -->
<!-- Centraliza e aplica espaçamento ao conteúdo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/background">

    <!-- Imagem do logo do aplicativo -->
    <!-- Define tamanho fixo para exibição -->
    <!-- Utilizada como identidade visual -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_techstore" />

    <!-- Campo de entrada para email -->
    <!-- Define container com estilo Material -->
    <!-- Exibe hint para orientação do usuário -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="E-mail"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp">

        <!-- Campo de texto para digitação do email -->
        <!-- Define tipo de entrada como email -->
        <!-- Associado ao layout acima -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo de entrada para senha -->
    <!-- Define container com estilo Material -->
    <!-- Permite alternar visibilidade da senha -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Senha"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="8dp"
        app:passwordToggleEnabled="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <!-- Campo de texto para digitação da senha -->
        <!-- Define tipo de entrada como senha -->
        <!-- Associado ao layout acima -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLoginSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Container para opções adicionais -->
    <!-- Agrupa checkbox e link de recuperação -->
    <!-- Organiza elementos horizontalmente via posicionamento -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <!-- Checkbox para lembrar senha -->
        <!-- Permite manter usuário logado -->
        <!-- Representa opção de persistência -->
        <CheckBox
            android:id="@+id/checkLembrarSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lembrar senha"
            android:textColor="@color/textSecondary" />

        <!-- Texto para recuperação de senha -->
        <!-- Permite navegar para fluxo de recuperação -->
        <!-- Posicionado à direita do container -->
        <TextView
            android:id="@+id/txtEsqueciSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:text="Esqueci minha senha"
            android:textColor="@color/primary"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Botão de login -->
    <!-- Executa ação principal da tela -->
    <!-- Envia dados para autenticação -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Entrar"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        android:textAllCaps="false"
        android:textSize="18sp"/>

    <!-- Texto para navegação para cadastro -->
    <!-- Indica ação alternativa ao usuário -->
    <!-- Direciona para criação de conta -->
    <TextView
        android:id="@+id/txtIrParaCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Não tem uma conta? Cadastre-se"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:padding="8dp"/>

</LinearLayout>