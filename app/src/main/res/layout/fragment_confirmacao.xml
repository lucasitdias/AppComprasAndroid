<?xml version="1.0" encoding="utf-8"?>

<!-- Layout principal da tela -->
<!-- Organiza os elementos em coluna vertical -->
<!-- Centraliza o conteúdo na tela -->
<!-- Define background e clickable para evitar sobreposição visual e de cliques -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Ícone de confirmação -->
    <!-- Representa sucesso na ação realizada -->
    <!-- Exibe feedback visual ao usuário -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_check_circle_custom"
        android:layout_marginBottom="24dp"/>

    <!-- Texto de mensagem de sucesso -->
    <!-- Informa conclusão do pedido -->
    <!-- Destaca resultado positivo da ação -->
    <TextView
        android:id="@+id/txtMensagemSucesso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pedido Finalizado com Sucesso!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="32dp"
        android:gravity="center"/>

    <!-- Botão para navegar para pedidos -->
    <!-- Permite acessar lista de pedidos -->
    <!-- Executa ação após confirmação -->
    <Button
        android:id="@+id/btnVoltarInicio"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="MEUS PEDIDOS"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        style="@style/Widget.Material3.Button.TonalButton"/>

</LinearLayout>